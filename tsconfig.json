{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "lib": [
      "ES2020",
      "DOM"
    ],
    "rootDir": "./src/ts",
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true,
    "noEmitOnError": true
  },
  "include": [
    "src/ts/**/*.ts"
  ]
}